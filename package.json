{
  "name": "data",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "description": "Data's house: its prompt, its knowledge, and the tooling that deploys its HTTP surface.",
  "scripts": {
    "deploy": "node --experimental-strip-types scripts/zo-deploy.ts",
    "test": "node --experimental-strip-types --test lib/*.test.ts archives/*/lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1"
  }
}
